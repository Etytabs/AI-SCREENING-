APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_screening

# Persistent proposal history used only by the duplication check.
AI_SCREENING_DUPLICATION_DB=data/private/duplication.sqlite3

# Optional first-stage semantic retrieval.
AI_SCREENING_EMBEDDINGS_ENABLED=false
AI_SCREENING_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_SCREENING_EMBEDDING_REVISION=

# Optional second-stage cross-encoder reranking.
AI_SCREENING_RERANKER_ENABLED=false
AI_SCREENING_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
AI_SCREENING_RERANKER_REVISION=

# Optional published-literature comparison for the plagiarism check (OpenAlex).
# Works without credentials; a key or polite-pool address raises the rate limit.
AI_SCREENING_OPENALEX_API_KEY=
AI_SCREENING_OPENALEX_MAILTO=
# Force on/off; default is on whenever a key or mailto address is set.
AI_SCREENING_OPENALEX_ENABLED=

# Seed the synthetic demonstration call and its 5 demo applications (default true).
AI_SCREENING_DEMO_SEED=true
# Seed the five synthetic DEMO-APP submissions into that call (default true).
AI_SCREENING_DEMO_APPLICATIONS=true
