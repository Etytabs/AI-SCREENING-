# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novarai
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Service URLs
ELIGIBILITY_SERVICE_URL=http://localhost:8001
PLAGIARISM_SERVICE_URL=http://localhost:8002
DUPLICATION_SERVICE_URL=http://localhost:8003
NOVELTY_SERVICE_URL=http://localhost:8004
REPORT_SERVICE_URL=http://localhost:8005
REGISTRY_SERVICE_URL=http://localhost:8006
INTEGRATION_SERVICE_URL=http://localhost:8007
ORCID_SERVICE_URL=http://localhost:8008
REPOSITORY_SERVICE_URL=http://localhost:8009
AUTH_SERVICE_URL=http://localhost:8010
EVIDENCE_SERVICE_URL=http://localhost:8011
REVIEWER_SERVICE_URL=http://localhost:8012
MONITORING_SERVICE_URL=http://localhost:8013

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# External Integration Keys
CROSSREF_API_KEY=your_crossref_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
EPO_API_KEY=your_epo_api_key_here

# ORCID Configuration
ORCID_CLIENT_ID=your_orcid_client_id_here
ORCID_CLIENT_SECRET=your_orcid_client_secret_here
ORCID_REDIRECT_URI=http://localhost:8008/callback

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6+PTX"

# Application Settings
APP_NAME=NOVARAai
APP_ENV=development
LOG_LEVEL=INFO
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.85
PLAGIARISM_THRESHOLD=0.75
